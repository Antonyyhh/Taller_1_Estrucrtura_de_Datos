{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build proyecto",
            "command": "C:\\TDM-GCC-64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-g3",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\ColaPacientes.cpp",
                "${workspaceFolder}\\ListaServicio.cpp",
                "${workspaceFolder}\\Paciente.cpp",
                "${workspaceFolder}\\Persona.cpp",
                "-o",
                "${workspaceFolder}\\output\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}