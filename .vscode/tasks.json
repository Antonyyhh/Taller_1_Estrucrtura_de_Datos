{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe compilar archivo activo",
            "command": "C:\\TDM-GCC-64\\bin\\g++.exe",
            "args": [
    "-fdiagnostics-color=always",
    "-Wall",
    "-Wextra",
    "-g3",
    "${workspaceFolder}\\*.cpp",
    "-o",
    "${workspaceFolder}\\main.exe"
],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}