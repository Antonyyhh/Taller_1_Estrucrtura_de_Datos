{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: Ejecutar proyecto completo",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/output/main.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "console": "externalTerminal",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/TDM-GCC-64/bin/gdb.exe",
      "preLaunchTask": "Build proyecto",
      "setupCommands": [
        { "description": "Habilitar pretty-printing para gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
